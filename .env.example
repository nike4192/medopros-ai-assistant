# Server Configuration
PORT=8001
SITE_URL=http://localhost:8001
SITE_NAME=Medopros MVP

# Security
SECRET_KEY=medopros_secret_key_change_me
LOGIN_USER=admin
LOGIN_PASSWORD=admin
UGMK_API_KEY=your_ugmk_api_key_here

# AI Models (OpenRouter) — LLM и запасной ASR
OPENROUTER_API_KEY=your_api_key_here
GPT_MODEL=openrouter/free

# ASR: gigaam (локально, по умолчанию) | openrouter (прежний Whisper)
ASR_ENGINE=gigaam
GIGAAM_MODEL=gigaam-v3-e2e-rnnt
GIGAAM_QUANTIZATION=int8
GIGAAM_MAX_SPEECH_S=25
GIGAAM_WARMUP=1
# Откат на Whisper через OpenRouter, если GigaAM упала
ASR_FALLBACK_OPENROUTER=1
AUDIO_MODEL=openai/whisper-large-v3-turbo
FALLBACK_AUDIO_MODELS=google/chirp-3,nvidia/parakeet-tdt-0.6b-v3,openai/whisper-1

# Notifications (Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
